{
  "name": "@jobber/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "start": "NODE_OPTIONS='--max-old-space-size=8192' nx run-many -t serve -p auth jobs executor products --parallel 4 --output-style=stream",
    "stop": "lsof -ti :3000 -ti :3001 -ti :3002 -ti :3003 | xargs kill -9 2>/dev/null || echo 'No servers running'",
    "docker:infra": "docker-compose up -d",
    "docker:apps": "docker-compose -f docker-compose.apps.yaml up --build",
    "docker:apps:down": "docker-compose -f docker-compose.apps.yaml down"
  },
  "workspaces": [
    "apps/*",
    "libs/*"
  ],
  "private": true,
  "dependencies": {
    "@as-integrations/express5": "^1.1.2",
    "@nestjs/common": "^12.6.3",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.6.3",
    "@nestjs/microservices": "^12.6.3",
    "@nestjs/platform-express": "^12.6.3",
    "@nestjs/throttler": "^6.8.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@types/pg": "^8.16.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "module-alias": "^2.2.3",
    "nestjs-pino": "^5.3.2",
    "pg": "^8.16.3",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "tslib": "^2.8.1",
    "uuid": "^13.0.2"
  },
  "_moduleAliases": {
    "@jobber/grpc": "dist/libs/grpc/main",
    "@jobber/graphql": "dist/libs/graphql/main",
    "@jobber/pulsar": "dist/libs/pulsar/main",
    "@jobber/nestjs": "dist/libs/nestjs/main",
    "@jobber/prisma": "dist/libs/prisma/main"
  },
  "devDependencies": {
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^12.6.3",
    "@nx/eslint": "24.0.7",
    "@nx/eslint-plugin": "24.0.7",
    "@nx/js": "24.0.7",
    "@nx/node": "24.0.7",
    "@nx/vite": "^24.0.7",
    "@nx/vitest": "^24.0.7",
    "@nx/web": "24.0.7",
    "@nx/webpack": "24.0.7",
    "@nx/workspace": "24.0.7",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.22",
    "@swc/helpers": "0.5.24",
    "@types/cookie-parser": "^1.4.10",
    "@types/node": "~25.0.3",
    "@typescript-eslint/eslint-plugin": "8.74.0",
    "@typescript-eslint/parser": "8.74.0",
    "eslint": "~9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "nx": "24.0.7",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.7.4",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.58.0",
    "unplugin-swc": "^2.0.0",
    "vite": "^8.4.0",
