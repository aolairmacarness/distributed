PORT=3000
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/auth
AUTH_GRPC_SERVICE_URL=0.0.0.0:5000
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MS=28800000
# Cookies are Secure by default; set false only for plain-HTTP local dev
SECURE_COOKIE=false

# Optional gRPC mutual TLS (set all three or none; PEM file paths)
GRPC_TLS_CA_FILE=
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
