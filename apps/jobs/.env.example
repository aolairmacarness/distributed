PORT=3001
DATABASE_URL=postgresql://postgres:<password>@localhost:5432/jobs
JOBS_GRPC_SERVICE_URL=0.0.0.0:5001
AUTH_GRPC_SERVICE_URL=localhost:5000
PULSAR_SERVICE_URL=pulsar://localhost:6650
# Optional, bytes (default 10 MiB)
MAX_UPLOAD_BYTES=

# Optional gRPC mutual TLS (set all three or none; PEM file paths)
GRPC_TLS_CA_FILE=
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=

# Optional Pulsar hardening
PULSAR_AUTH_TOKEN=
PULSAR_TLS_TRUST_CERTS_FILE=
